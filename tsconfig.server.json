{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.cache/server.tsbuildinfo",
    "sourceMap": true,
    "declaration": true,
    "types": ["node"]
  },
  "include": ["src/builder/**/*.ts", "src/server/**/*.ts", "src/shared/**/*.ts"]
}
